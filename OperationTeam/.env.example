# Public YouTube Data API
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_HANDLE=@AIMudaLab
YOUTUBE_CHANNEL_ID=

# OAuth: refresh-token方式を推奨
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# 一時的な代替。短時間で失効するため通常は空欄にする
YOUTUBE_ACCESS_TOKEN=

# Local narration defaults
VOICEVOX_HOST=http://127.0.0.1:50021
VOICEVOX_SPEAKER=3

# Optional FFmpeg paths when not available on PATH
FFMPEG_PATH=
FFPROBE_PATH=
